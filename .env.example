# ---- 数据/索引 ----
DATA_ROOT=/run/media/myj/D/code_agent
DB_PATH=

# ---- 会话存储：sqlite（默认）或 mysql ----
DATABASE_URL=
# 示例: mysql+pymysql://codeagent:codeagent@127.0.0.1:3307/codeagent?charset=utf8mb4

# ---- LLM（OpenAI 兼容） ----
LLM_PROVIDERS=
OPENCODE_GO_API_KEY=

# ---- Neo4j 代码图（R2） ----
NEO4J_URI=bolt://127.0.0.1:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=codeagent-local-dev
# 可选；留空使用服务端默认库
NEO4J_DATABASE=

# ---- 代码图 LLM 候选边（可选，默认值如下） ----
# GRAPH_LLM_MAX_CANDIDATES=30
# GRAPH_LLM_CONFIDENCE=0.6
# GRAPH_LLM_FANOUT=50
# GRAPH_LLM_BUDGET_TOKENS=12000
# GRAPH_LLM_MAX_OUTPUT_TOKENS=4096
